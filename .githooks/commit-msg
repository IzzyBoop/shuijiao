#!/bin/sh
# Enforces Conventional Commits: type(scope)!: subject
set -eu

subject=$(grep -v '^#' "$1" | head -n 1)
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert|security)(\([a-z0-9._/-]+\))?!?: [^ ].{0,70}$'

if ! printf '%s' "$subject" | grep -Eq "$pattern"; then
  echo "commit-msg: subject must follow Conventional Commits, max 72 chars, e.g." >&2
  echo "  feat(flashcards): add review session" >&2
  echo "got: $subject" >&2
  exit 1
fi
