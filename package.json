{
  "name": "shuijiao",
  "version": "0.1.0-beta.4",
  "private": true,
  "description": "A static, offline-capable Mandarin flashcard portal. All study data stays in the student's browser.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run check:resources && vite build && node tools/check-dist.mjs",
    "preview": "vite preview --strictPort --port 4173",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "dict": "node tools/build-dict.ts",
    "check:resources": "node tools/check-resources.ts",
    "course": "node tools/make-course-deck.ts",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test"
  },
  "dependencies": {
    "dexie": "4.4.7",
    "opencc-js": "1.4.2",
    "pinyin-pro": "3.29.5",
    "preact": "11.1.1",
    "ts-fsrs": "6.0.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "fake-indexeddb": "6.2.7",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.3"
  }
}
